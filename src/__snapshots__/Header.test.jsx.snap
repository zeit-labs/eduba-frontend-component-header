        className="logo"
        href="/ar"
      >
        <img
          alt="edX"
          className="d-block"
          src="https://edx-cdn.org/v3/default/logo.svg"
        />
      </a>
      <nav
        aria-label="الرئيسية"
        className="nav main-nav"
      >
        <eduba-explore
          api="/api/eduba/categories/v1/categories/"
          base="/ar"
          label="اكتشف"
          lang="ar"
        >
          <a
            className="nav-link"
            href="/ar#categories"
          >
            اكتشف
          </a>
        </eduba-explore>
        <a
          className="nav-link"
          href="/ar/courses"
          onClick={null}
        >
          المقررات
        </a>
        <a
          className="nav-link"
          href="/ar/contact-us"
          onClick={null}
        >
          اتصل بنا
        </a>
      </nav>
      <nav
        aria-label="ثانوي"
        className="nav secondary-menu-container align-items-center ml-auto"
      >
        <div
          className="container-desktop-logged-out-items"
        >
          <a
            className="btn-outline-primary"
            href="http://localhost:18000/login"
          >
            تسجيل الدخول
          </a>
        </div>
      </nav>
      <button
        className="language-switcher-btn"
        onClick={[Function]}
        style={
          {
            "borderColor": "#6b7280",
            "borderRadius": "8px",
            "borderStyle": "solid",
            "borderWidth": "1px",
          }
        }
        type="button"
      >
        En
      </button>
    </div>
  </div>
</header>
`;

